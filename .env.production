# Build-time configuration for deployed builds.
#
# Vite inlines this into the bundle at `npm run build`, so any host — Vercel,
# Netlify, GitHub Pages — produces a working site with no dashboard setup.
#
# This is committed on purpose. The value is a public, write-only collection
# endpoint: it has to be reachable by every anonymous participant, and it is
# already visible in the deployed JavaScript. Keeping it here means an
# auto-deploy cannot silently ship a build that can't submit.
#
# It is not a credential. Nothing can be read out of the sheet with it, and
# the Apps Script validates everything it receives. If it is ever abused,
# deploy a new Apps Script version, which issues a new URL, and replace it.
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbwyYWoygWe14-4GV12zV8GM30OqoY1QoM-Vmr6SKPzWETQNnV5Ip9ziuU-fVQPb_jxX/exec
VITE_SURVEY_DRY_RUN=false
