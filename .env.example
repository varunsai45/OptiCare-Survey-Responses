# OptiCare research site configuration
#
# Paste the Google Apps Script Web App URL you get after deploying
# apps-script/Code.gs (see README.md, section "Google Sheets setup").
#
# Copy this file to `.env` and fill in the value. Never commit `.env`.
#
# Note: this endpoint is a public write-only collection URL, not a secret.
# Validation happens server-side inside Apps Script.
VITE_GOOGLE_SCRIPT_URL=

# Optional. Set to "true" to log submissions to the console instead of
# sending them anywhere. Useful while developing so you never write test
# rows into the real research sheet.
VITE_SURVEY_DRY_RUN=false
